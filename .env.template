# Másold át .env néven:
#   cp .env.template .env
# A .env fájl gitignore-olva van, valódi tokent/jelszót ne commitolj.

# A hoston publikált port
MIRROR_PORT=8088

# Időjárás helye (példa: Budapest)
WEATHER_LAT=47.4979
WEATHER_LON=19.0402
WEATHER_TZ=Europe/Budapest

# Google Calendar
# Google Calendar -> Settings -> Integrate calendar -> Secret address in iCal format
GOOGLE_CALENDAR_ICAL_URL=

# Trello
# https://trello.com/power-ups/admin/ - API key / token
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
